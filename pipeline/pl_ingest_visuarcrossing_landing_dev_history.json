{
	"name": "pl_ingest_visuarcrossing_landing_dev_history",
	"properties": {
		"activities": [
			{
				"name": "web_get_apikey",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://kv-atmos-dev-eastus-001.vault.azure.net/secrets/visualcrossing-api-key-dev/1f3710a4cc584c508e2c386da40cf3b0?api-version=2025-07-01",
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net/"
					}
				}
			},
			{
				"name": "set_date_list",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "web_get_apikey",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Date_list",
					"value": {
						"value": "@range(0,add(div(sub(ticks(pipeline().parameters.endDate),ticks(pipeline().parameters.startDate)),864000000000),1))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Foreach_date",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "set_date_list",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('Date_list')",
						"type": "Expression"
					},
					"batchCount": 10,
					"activities": [
						{
							"name": "Copy_visualcrossing_to_landing",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "JsonSource",
									"storeSettings": {
										"type": "HttpReadSettings",
										"requestMethod": "GET"
									},
									"formatSettings": {
										"type": "JsonReadSettings"
									}
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "JsonWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "ds_json_visualcrossing_src_dev",
									"type": "DatasetReference",
									"parameters": {
										"city": {
											"value": "@pipeline().parameters.city",
											"type": "Expression"
										},
										"date": {
											"value": "@formatDateTime(addDays(pipeline().parameters.startDate,item()), 'yyyy-MM-dd')",
											"type": "Expression"
										},
										"apikey": {
											"value": "@activity('web_get_apikey').output.value",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_json_visualcrossing_landing_dev",
									"type": "DatasetReference",
									"parameters": {
										"city": {
											"value": "@pipeline().parameters.city",
											"type": "Expression"
										},
										"date": {
											"value": "@formatDateTime(addDays(pipeline().parameters.startDate,item()), 'yyyy-MM-dd')",
											"type": "Expression"
										},
										"file_name": {
											"value": "@toLower(concat('atmos_',pipeline().parameters.city,'_',formatDateTime(utcnow(),'yyyyMMddHHmmss'),'.json'))",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"city": {
				"type": "string",
				"defaultValue": "brasilia"
			},
			"startDate": {
				"type": "string"
			},
			"endDate": {
				"type": "string"
			}
		},
		"variables": {
			"v_date": {
				"type": "String"
			},
			"Date_list": {
				"type": "Array"
			}
		},
		"folder": {
			"name": "VisualCrossing"
		},
		"annotations": []
	}
}